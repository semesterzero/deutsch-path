---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { sortPostsByDateDesc } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && data.intake);
  const byIntake = new Map<string, typeof posts>();

  for (const post of posts) {
    const intake = post.data.intake!;
    const existing = byIntake.get(intake) ?? [];
    existing.push(post);
    byIntake.set(intake, existing);
  }

  return [...byIntake.entries()].map(([intake, posts]) => ({
    params: { slug: intake },
    props: { intake, posts },
  }));
}

const { intake, posts } = Astro.props;
const sorted = sortPostsByDateDesc(posts);
const description = `Experiences from the ${intake} intake of Indian students moving to Germany.`;
---

<BaseLayout title={intake} description={description}>
  <h1 class="font-display text-3xl mb-8">{intake}</h1>

  <PostList posts={sorted} />
</BaseLayout>
