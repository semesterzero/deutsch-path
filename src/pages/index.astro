---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Asterisk from '../components/Asterisk.astro';
import { getSortedPosts } from '../lib/posts';

const posts = await getSortedPosts();

const journey = ['Applications', 'APS', 'Visa appointments', 'Blocked accounts', 'Arrival', 'Studying', 'Working'];
---

<BaseLayout title="Home">
  <h1 class="font-display text-center text-4xl leading-tight md:text-5xl">
    Real experiences of moving from India to Germany for a Master's.
  </h1>
  <p class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-base-content/70">
    {journey.map((word, i) => (
      <>
        {i > 0 && <Asterisk size={10} />}
        <span>{word}</span>
      </>
    ))}
  </p>

  <div aria-hidden="true" class="my-10 flex justify-center">
    <Asterisk size={18} />
  </div>

  <PostList posts={posts} />
</BaseLayout>
