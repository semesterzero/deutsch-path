---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { slugify } from '../../lib/url';
import { sortPostsByDateDesc } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && data.university);
  const byUniversity = new Map<string, typeof posts>();

  for (const post of posts) {
    const university = post.data.university!;
    const slug = slugify(university);
    const existing = byUniversity.get(slug) ?? [];
    existing.push(post);
    byUniversity.set(slug, existing);
  }

  return [...byUniversity.entries()].map(([slug, posts]) => ({
    params: { slug },
    props: { posts },
  }));
}

const { posts } = Astro.props;
const university = posts[0].data.university!;
const sorted = sortPostsByDateDesc(posts);
---

<BaseLayout title={university}>
  <h1 class="font-display text-3xl mb-8">{university}</h1>

  <PostList posts={sorted} />
</BaseLayout>
