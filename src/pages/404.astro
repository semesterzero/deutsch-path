---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist on Deutsch Path — head back to the homepage to keep browsing."
  noindex
>
  <h1 class="font-display text-3xl mb-4">Page not found</h1>
  <p>That page doesn't exist. <a class="underline hover:text-base-content/70" href={withBase('/')}>Back to the homepage</a>.</p>
</BaseLayout>
