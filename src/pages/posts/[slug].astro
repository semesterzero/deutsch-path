---
import { getCollection, getEntry, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);

let translations: { lang: typeof post.data.lang; slug: string }[] = [];
if (post.data.translationGroup) {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);
  translations = allPosts
    .filter((p) => p.data.translationGroup === post.data.translationGroup && p.id !== post.id)
    .map((p) => ({ lang: p.data.lang, slug: p.id }));
}
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  type={post.data.type}
  stage={post.data.stage}
  date={post.data.date}
  lastVerified={post.data.lastVerified}
  authorName={author?.data.displayName ?? post.data.author.id}
  university={post.data.university}
  city={post.data.city}
  intake={post.data.intake}
  tags={post.data.tags}
  lang={post.data.lang}
  translations={translations}
>
  <Content />
</PostLayout>
