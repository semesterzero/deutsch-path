---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { STAGES, STAGE_LABELS } from '../../lib/constants';

export async function getStaticPaths() {
  // Every stage always gets a route, even with zero posts — it's a fixed
  // taxonomy, not derived from whatever content happens to exist.
  return STAGES.map((stage) => ({ params: { slug: stage } }));
}

const { slug } = Astro.params;
const stage = slug as (typeof STAGES)[number];

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.stage === stage)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title={STAGE_LABELS[stage]}>
  <h1>{STAGE_LABELS[stage]}</h1>

  {posts.length === 0 && <p>No posts for this stage yet.</p>}

  {posts.map((post) => (
    <PostCard
      slug={post.id}
      title={post.data.title}
      description={post.data.description}
      type={post.data.type}
      stage={post.data.stage}
      date={post.data.date}
    />
  ))}
</BaseLayout>
