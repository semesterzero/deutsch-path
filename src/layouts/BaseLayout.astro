---
import { Icon } from 'astro-icon/components';
import StageNav from '../components/StageNav.astro';
import GermanMark from '../components/GermanMark.astro';
import { REPO_URL, type Language } from '../lib/constants';
import { withBase } from '../lib/url';
import { newPostGitHubUrl } from '../lib/newPostUrl';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: Language;
}

const {
  title,
  description = 'Real experiences of moving from India to Germany for a Master\'s.',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="editorial">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title="Deutsch Path" href={withBase('/rss.xml')} />
    <title>{title} · Deutsch Path</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content">
    <header class="flex flex-wrap items-center justify-between gap-4 border-b border-base-300 px-6 py-6 md:px-10">
      <a href={withBase('/')} class="inline-flex items-center gap-2 font-display text-xl tracking-tight">
        <GermanMark />
        Deutsch Path
      </a>
      <nav aria-label="Primary" class="flex flex-wrap gap-6 text-xs tracking-widest uppercase text-base-content/70">
        <a class="hover:text-base-content" href={withBase('/')}>Home</a>
        <a class="inline-flex items-center gap-1 hover:text-base-content" href={withBase('/search/')}>
          <Icon name="lucide:search" width={13} height={13} />
          Search
        </a>
        <a class="inline-flex items-center gap-1 text-accent hover:text-accent/70" href={newPostGitHubUrl()}>
          Write a post
          <Icon name="lucide:arrow-up-right" width={13} height={13} />
        </a>
        <a class="inline-flex items-center gap-1 hover:text-base-content" href={REPO_URL}>
          <Icon name="lucide:github" width={14} height={14} />
          GitHub
        </a>
      </nav>
    </header>

    <div class="border-b border-base-300 px-6 py-3 md:px-10">
      <StageNav />
    </div>

    <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12 md:px-10">
      <slot />
    </main>

    <footer class="border-t border-base-300 px-6 py-12 text-center text-xs text-base-content/60 md:px-10">
      <div class="mx-auto flex max-w-md flex-col gap-4">
        <p>
          Deutsch Path is a <span class="text-base-content/80">Semester Zero</span> project.
        </p>
        <p>
          Code is MIT licensed. Content is CC BY 4.0 — authors keep copyright
          and grant publishing rights. See
          <a class="underline hover:text-base-content" href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING</a> to write a post.
        </p>
      </div>
      <div class="mx-auto mt-8 max-w-md border-t border-base-300 pt-6 text-base-content/50">
        <p>Built by Srikhar Shashi D, for future aspirants.</p>
      </div>
    </footer>
  </body>
</html>
