---
import StageNav from '../components/StageNav.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Real experiences of moving from India to Germany for a Master\'s.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <title>{title} · Semester Zero</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-primary">
    <div class="mx-2 my-2 md:mx-6 md:my-6 flex min-h-[calc(100vh-1rem)] md:min-h-[calc(100vh-3rem)] flex-col bg-base-100 text-base-content">
      <header class="flex flex-wrap items-center justify-between gap-4 border-b border-base-300 px-6 py-6 md:px-10">
        <a href={withBase('/')} class="font-display text-xl tracking-tight lowercase">semester zero</a>
        <nav aria-label="Primary" class="flex flex-wrap gap-6 text-xs tracking-widest uppercase text-base-content/70">
          <a class="hover:text-base-content" href={withBase('/')}>Home</a>
          <a class="hover:text-base-content" href="https://github.com/semesterzero/main-blog/blob/main/CONTRIBUTING.md">Write a post</a>
          <a class="hover:text-base-content" href="https://github.com/semesterzero/main-blog">GitHub</a>
        </nav>
      </header>

      <div class="border-b border-base-300 px-6 py-3 md:px-10">
        <StageNav />
      </div>

      <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12 md:px-10">
        <slot />
      </main>

      <footer class="border-t border-base-300 px-6 py-6 text-center text-xs text-base-content/60 md:px-10">
        <p>
          Code is MIT licensed. Content is CC BY 4.0 — authors keep copyright
          and grant publishing rights. See
          <a class="underline hover:text-base-content" href="https://github.com/semesterzero/main-blog/blob/main/CONTRIBUTING.md">CONTRIBUTING</a> to write a post.
        </p>
      </footer>
    </div>
  </body>
</html>
