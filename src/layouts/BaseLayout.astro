---
import StageNav from '../components/StageNav.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Real experiences of moving from India to Germany for a Master\'s.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <title>{title} · Semester Zero</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content flex flex-col">
    <header class="navbar border-b border-base-300 mx-auto max-w-3xl px-4">
      <div class="flex-1">
        <a class="text-lg font-bold" href={withBase('/')}>Semester Zero</a>
      </div>
    </header>
    <div class="border-b border-base-300 mx-auto w-full max-w-3xl px-4 py-3">
      <StageNav />
    </div>
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="footer footer-center border-t border-base-300 mx-auto w-full max-w-3xl px-4 py-6 text-sm text-base-content/70">
      <p>
        Code is MIT licensed. Content is CC BY 4.0 — authors keep copyright
        and grant publishing rights. See
        <a class="link" href="https://github.com/semesterzero/main-blog/blob/main/CONTRIBUTING.md">CONTRIBUTING</a> to write a post.
      </p>
    </footer>
  </body>
</html>
