---
import StageNav from '../components/StageNav.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Real experiences of moving from India to Germany for a Master\'s.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <title>{title} · Semester Zero</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <a class="site-name" href={withBase('/')}>Semester Zero</a>
      <StageNav />
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Code is MIT licensed. Content is CC BY 4.0 — authors keep copyright
        and grant publishing rights. See
        <a href="https://github.com/semesterzero/main-blog/blob/main/CONTRIBUTING.md">CONTRIBUTING</a> to write a post.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, sans-serif;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1rem;
    color: #1a1a1a;
    line-height: 1.5;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #e2e2e2;
  }

  .site-name {
    font-weight: 700;
    font-size: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  footer {
    margin-top: 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid #e2e2e2;
    font-size: 0.8rem;
    color: #666;
  }
</style>
