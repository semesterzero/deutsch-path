---
import BaseLayout from './BaseLayout.astro';
import Disclaimer from '../components/Disclaimer.astro';
import FreshnessBanner from '../components/FreshnessBanner.astro';
import Asterisk from '../components/Asterisk.astro';
import { LANGUAGE_LABELS, STAGE_LABELS, type Language, type Stage } from '../lib/constants';

interface Props {
  title: string;
  description: string;
  type: 'experience' | 'guide';
  stage: Stage;
  date: Date;
  lastVerified: Date;
  authorName: string;
  university?: string;
  city?: string;
  intake?: string;
  tags: string[];
  lang: Language;
}

const {
  title,
  description,
  type,
  stage,
  date,
  lastVerified,
  authorName,
  university,
  city,
  intake,
  tags,
  lang,
} = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang}>
  <article>
    <p class="text-xs tracking-widest uppercase text-base-content/50">
      <span class={type === 'experience' ? 'text-accent' : 'text-secondary'}>{type}</span>
      {' '}· {STAGE_LABELS[stage]} ·{' '}
      <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
      {' '}· by {authorName}
      {lang !== 'en' && <>{' '}· <span class="text-accent">{LANGUAGE_LABELS[lang]}</span></>}
    </p>
    <h1 class="font-display mt-3 text-4xl leading-tight md:text-5xl">{title}</h1>

    <div aria-hidden="true" class="my-8 flex justify-center">
      <Asterisk size={18} />
    </div>

    <Disclaimer />
    <FreshnessBanner lastVerified={lastVerified} />

    <div class="prose prose-neutral max-w-none prose-headings:font-display">
      <slot />
    </div>

    {type === 'experience' && (
      <dl class="mt-10 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 border-t border-base-300 pt-6 text-sm">
        <dt class="text-base-content/50">University</dt>
        <dd>{university}</dd>
        <dt class="text-base-content/50">City</dt>
        <dd>{city}</dd>
        <dt class="text-base-content/50">Intake</dt>
        <dd>{intake}</dd>
      </dl>
    )}

    {tags.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-x-3 gap-y-1 text-xs tracking-widest uppercase text-info">
        {tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    )}
  </article>
</BaseLayout>
