---
import BaseLayout from './BaseLayout.astro';
import Disclaimer from '../components/Disclaimer.astro';
import FreshnessBanner from '../components/FreshnessBanner.astro';
import { STAGE_LABELS, type Stage } from '../lib/constants';

interface Props {
  title: string;
  description: string;
  type: 'experience' | 'guide';
  stage: Stage;
  date: Date;
  lastVerified: Date;
  authorName: string;
  university?: string;
  city?: string;
  intake?: string;
  tags: string[];
}

const {
  title,
  description,
  type,
  stage,
  date,
  lastVerified,
  authorName,
  university,
  city,
  intake,
  tags,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/60">
      <span class="badge badge-outline capitalize">{type}</span>
      <span class="badge badge-outline">{STAGE_LABELS[stage]}</span>
      <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
      <span>· by {authorName}</span>
    </div>
    <h1 class="text-3xl font-bold mt-2 mb-4">{title}</h1>

    <Disclaimer />
    <FreshnessBanner lastVerified={lastVerified} />

    <div class="prose prose-base max-w-none mt-6">
      <slot />
    </div>

    {type === 'experience' && (
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm mt-8 text-base-content/80">
        <dt class="text-base-content/50">University</dt>
        <dd>{university}</dd>
        <dt class="text-base-content/50">City</dt>
        <dd>{city}</dd>
        <dt class="text-base-content/50">Intake</dt>
        <dd>{intake}</dd>
      </dl>
    )}

    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mt-6">
        {tags.map((tag) => <li class="badge badge-ghost">#{tag}</li>)}
      </ul>
    )}
  </article>
</BaseLayout>
