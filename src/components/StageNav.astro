---
import { Icon } from 'astro-icon/components';
import { STAGES, STAGE_ICONS, STAGE_LABELS } from '../lib/constants';
import { withBase } from '../lib/url';
---

<nav
  aria-label="Stages"
  class="flex items-center gap-x-3 overflow-x-auto whitespace-nowrap text-xs tracking-widest uppercase text-base-content/60 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:flex-wrap md:overflow-visible md:whitespace-normal"
>
  {STAGES.map((stage, i) => (
    <>
      {i > 0 && <span aria-hidden="true" class="shrink-0 text-base-content/30">·</span>}
      <a class="inline-flex shrink-0 items-center gap-1 py-1.5 hover:text-base-content" href={withBase(`/stage/${stage}/`)}>
        <Icon name={STAGE_ICONS[stage]} width={12} height={12} />
        {STAGE_LABELS[stage]}
      </a>
    </>
  ))}
</nav>
