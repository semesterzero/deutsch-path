---
import { STAGES, STAGE_LABELS } from '../lib/constants';
import { withBase } from '../lib/url';
---

<nav class="stage-nav" aria-label="Stages">
  <ul>
    {STAGES.map((stage) => (
      <li>
        <a href={withBase(`/stage/${stage}/`)}>{STAGE_LABELS[stage]}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .stage-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stage-nav a {
    text-decoration: none;
    color: inherit;
    font-size: 0.9rem;
  }

  .stage-nav a:hover {
    text-decoration: underline;
  }
</style>
