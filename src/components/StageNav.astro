---
import { Icon } from 'astro-icon/components';
import { STAGES, STAGE_ICONS, STAGE_LABELS } from '../lib/constants';
import { withBase } from '../lib/url';
---

<nav aria-label="Stages" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs tracking-widest uppercase text-base-content/60">
  {STAGES.map((stage, i) => (
    <>
      {i > 0 && <span aria-hidden="true" class="text-base-content/30">·</span>}
      <a class="inline-flex items-center gap-1 hover:text-base-content" href={withBase(`/stage/${stage}/`)}>
        <Icon name={STAGE_ICONS[stage]} width={12} height={12} />
        {STAGE_LABELS[stage]}
      </a>
    </>
  ))}
</nav>
