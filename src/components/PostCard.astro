---
import { STAGE_LABELS, type Stage } from '../lib/constants';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  description: string;
  type: 'experience' | 'guide';
  stage: Stage;
  date: Date;
}

const { slug, title, description, type, stage, date } = Astro.props;
---

<article class="card card-border border-base-300 mb-4">
  <div class="card-body p-4">
    <div class="flex items-center gap-2 text-xs text-base-content/60">
      <span class="badge badge-outline capitalize">{type}</span>
      <span class="badge badge-outline">{STAGE_LABELS[stage]}</span>
      <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
    </div>
    <h3 class="card-title text-base mt-1">
      <a class="link link-hover" href={withBase(`/posts/${slug}/`)}>{title}</a>
    </h3>
    <p class="text-base-content/80">{description}</p>
  </div>
</article>
