---
import { STAGE_LABELS, type Stage } from '../lib/constants';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  description: string;
  type: 'experience' | 'guide';
  stage: Stage;
  date: Date;
}

const { slug, title, description, type, stage, date } = Astro.props;
---

<article class="grid grid-cols-1 gap-2 border-b border-base-300 py-6 first:pt-0 md:grid-cols-[10rem_1fr] md:gap-8">
  <p class="text-xs tracking-widest uppercase text-base-content/50">
    {type} · {STAGE_LABELS[stage]}
    <br />
    <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
  </p>
  <div>
    <h3 class="font-display text-2xl">
      <a class="hover:underline" href={withBase(`/posts/${slug}/`)}>{title}</a>
    </h3>
    <p class="mt-2 text-base-content/70">{description}</p>
  </div>
</article>
