---
import { Icon } from 'astro-icon/components';
import { LANGUAGE_LABELS, POST_TYPE_COLOR, STAGE_LABELS, type Language, type PostType, type Stage } from '../lib/constants';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  description: string;
  type: PostType;
  stage: Stage;
  date: Date;
  lang: Language;
}

const { slug, title, description, type, stage, date, lang } = Astro.props;
---

<article class="grid grid-cols-1 gap-2 border-b border-base-300 py-6 first:pt-0 md:grid-cols-[10rem_1fr] md:gap-8">
  <p class="text-xs tracking-widest uppercase text-base-content/50">
    <span class={POST_TYPE_COLOR[type]}>{type}</span>
    {' '}· {STAGE_LABELS[stage]}
    {lang !== 'en' && <>{' '}· <span class="text-accent">{LANGUAGE_LABELS[lang]}</span></>}
    <br />
    <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
  </p>
  <div>
    <h3 class="font-display text-2xl">
      <a class="group inline-flex items-center gap-1.5 hover:underline" href={withBase(`/posts/${slug}/`)}>
        {title}
        <Icon name="lucide:arrow-right" width={18} height={18} class="shrink-0 -translate-x-1 text-accent opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100" />
      </a>
    </h3>
    <p class="mt-2 text-base-content/70">{description}</p>
  </div>
</article>
