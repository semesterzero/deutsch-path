---
import { STAGE_LABELS, type Stage } from '../lib/constants';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  description: string;
  type: 'experience' | 'guide';
  stage: Stage;
  date: Date;
}

const { slug, title, description, type, stage, date } = Astro.props;
---

<article class="post-card">
  <p class="meta">
    <span class="badge">{type}</span>
    <span class="badge">{STAGE_LABELS[stage]}</span>
    <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
  </p>
  <h3><a href={withBase(`/posts/${slug}/`)}>{title}</a></h3>
  <p>{description}</p>
</article>

<style>
  .post-card {
    border-bottom: 1px solid #e2e2e2;
    padding: 1rem 0;
  }

  .meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    color: #666;
    margin: 0 0 0.25rem;
  }

  .badge {
    border: 1px solid #ccc;
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    text-transform: capitalize;
  }

  h3 {
    margin: 0 0 0.25rem;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }
</style>
