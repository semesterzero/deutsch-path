---
import { LANGUAGE_LABELS, type Language } from '../lib/constants';
import { withBase } from '../lib/url';

interface Props {
  current: Language;
  translations: { lang: Language; slug: string }[];
  // Used on listing cards, where the toggle sits inline with other meta
  // rather than as its own labeled line.
  compact?: boolean;
}

const { current, translations, compact = false } = Astro.props;
const all = [{ lang: current, slug: undefined }, ...translations].sort((a, b) =>
  a.lang.localeCompare(b.lang)
);
---

{translations.length > 0 && (
  <div class:list={[
    'flex items-center gap-2 uppercase text-base-content/50',
    compact ? 'text-[0.65rem] tracking-wide' : 'text-xs tracking-widest',
  ]}>
    {!compact && <span>Also in:</span>}
    {all.map(({ lang, slug }, i) => (
      <>
        {i > 0 && <span class="text-base-content/30">·</span>}
        {lang === current ? (
          <span class="text-accent">{LANGUAGE_LABELS[lang]}</span>
        ) : (
          <a class="hover:text-base-content" href={withBase(`/posts/${slug}/`)}>{LANGUAGE_LABELS[lang]}</a>
        )}
      </>
    ))}
  </div>
)}
