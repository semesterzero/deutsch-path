---
interface Props {
  lastVerified: Date;
}

const { lastVerified } = Astro.props;

// Evaluated at build time — a static site can only be as fresh as its last
// deploy, it can't check this live.
const twelveMonthsMs = 365 * 24 * 60 * 60 * 1000;
const isStale = Date.now() - lastVerified.getTime() > twelveMonthsMs;
---

{isStale && (
  <div role="alert" class="alert alert-warning alert-soft my-4 text-sm">
    <span>
      Facts in this post were last verified on{' '}
      {lastVerified.toISOString().slice(0, 10)}, more than a year ago. Visa
      rules, fees, and requirements change yearly — double-check anything
      specific before relying on it.
    </span>
  </div>
)}
